# AGLETRAS - Environment Configuration Example
# This website is engineered as a secure, static-export site (output: 'export').
# No server-side secrets or databases are required for core static hosting.

# Optional: Custom domain configuration for canonical tags
NEXT_PUBLIC_SITE_URL=https://agletras.com

# Optional: In the future, if a headless submission backend (e.g. Cloudflare Worker or AWS SES API)
# is integrated for automated intake, configure the intake webhook URL below:
# NEXT_PUBLIC_CONTACT_WEBHOOK_URL=https://api.agletras.com/v1/inquire
